# AI NOTE — local configuration. Copy to .env.local and adjust.
# Local processing is the default. Optional Soniox streaming uses the credential below.

# --- Realtime transcription/translation provider (optional) ---
# Keep this long-lived key in .env.local only. The local server mints a single-use,
# 60-second temporary key for the browser; it never returns this long-lived key.
SONIOX_API_KEY=

# --- External summary model API key (optional) ---
# When set, the "외부 모델" summarizer calls the provider's HTTPS API directly —
# no CLI install needed on this machine. Keep it in .env.local only; the app
# never stores or echoes it. (OPENAI_API_KEY is honored as a fallback name.)
CODEX_API_KEY=

# --- Whisper (local STT service) ---
# Model: large-v3 is best but multi-GB; use base/small for a fast first run.
LOCAL_STT_MODEL=large-v3
# Decode language: a Whisper language code (e.g. ko, en) or "auto" to detect.
LOCAL_STT_LANG=ko
# Silence/hallucination filter (VAD + no repeat-conditioning). On by default; set 0 to disable.
LOCAL_STT_VAD=1
# Service bind address (keep on 127.0.0.1 — never expose to the LAN).
LOCAL_STT_HOST=127.0.0.1
LOCAL_STT_PORT=8123
# Optional: MLX model repo override (Apple Silicon).
# LOCAL_STT_MLX_REPO=mlx-community/whisper-large-v3-mlx
# Optional: path to the glossary JSON (defaults to ./glossary.json). Despite the
# LOCAL_STT_ prefix, the glossary feeds the LLM correction step, not Whisper.
# Normally you don't set this — manage terms/corrections in the app's "단어 관리" tab.
# LOCAL_STT_GLOSSARY=./glossary.json

# --- ffmpeg ---
# Explicit ffmpeg binary if it's not on PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# --- Test/dev stubs (leave unset in normal use) ---
# FAKE_WHISPER=1
# FAKE_FFMPEG=1
# FAKE_LLM=1
# Disable the background auto-summarize worker (e.g. for tests/CI).
# AI_NOTE_DISABLE_WORKER=1
