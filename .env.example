# AI NOTE — local configuration. Copy to .env.local and adjust.

# --- Required cloud services ---
# Async and realtime transcription. The browser receives only a single-use,
# 60-second temporary key; this long-lived key remains on the server.
SONIOX_API_KEY=

# Summary, transcript cleanup, chat, and translation. The app applies task-based,
# price-sorted model fallbacks with zero-retention/data-collection-deny routing.
OPENROUTER_API_KEY=

# --- Customer password recovery email (SMTP) ---
# Use provider-issued SMTP credentials (for example AWS SES SMTP credentials).
# Port 465 uses immediate TLS; port 587 must use STARTTLS.
AI_NOTE_SMTP_HOST=
AI_NOTE_SMTP_PORT=587
AI_NOTE_SMTP_SECURE=false
AI_NOTE_SMTP_USER=
AI_NOTE_SMTP_PASSWORD=
AI_NOTE_SMTP_FROM="AI 노트 <no-reply@example.com>"

# Optional glossary path. Normally manage terms in the app instead.
# AI_NOTE_GLOSSARY_PATH=./glossary.json

# Set these only on an HTTPS deployment behind a trusted reverse proxy/tunnel.
# AI_NOTE_DEPLOYMENT_MODE=cloud
# APP_ORIGIN=https://your-stable-domain.example

# --- ffmpeg ---
# Explicit ffmpeg binary if it's not on PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# --- Test/dev stubs (leave unset in normal use) ---
# FAKE_SONIOX=1
# FAKE_FFMPEG=1
# FAKE_LLM=1
# FAKE_PASSWORD_EMAIL=1
# Disable the background auto-summarize worker (e.g. for tests/CI).
# AI_NOTE_DISABLE_WORKER=1
